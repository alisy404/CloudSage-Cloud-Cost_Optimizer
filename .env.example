APP_ENV=development
AWS_REGION=us-east-1
AWS_MODE=true
# Testing window: last 60 minutes, sampled every 5 minutes.
CLOUDWATCH_WINDOW_MINUTES=60
CLOUDWATCH_PERIOD_SECONDS=300
# Testing only: permits candidate/AI analysis before a full production history exists.
ANALYSIS_ALLOW_SHORT_WINDOW=true
LLM_PROVIDER=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10
